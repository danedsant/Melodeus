            VALUE "LegalCopyright",   "Orquestada por danedsant con Antigravity y OpenCode"
            VALUE "OriginalFilename", "Melodeus.exe"
            VALUE "ProductName",      "Melodeus DJ"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
